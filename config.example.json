{
  "harnesses": {
    "claude": {
      "enabled": true,
      "command": "claude"
    },
    "claudeLocal": {
      "enabled": false,
      "command": "claude",
      "env": {
        "ANTHROPIC_BASE_URL": "http://localhost:8000",
        "ANTHROPIC_API_KEY": "dummy",
        "ANTHROPIC_AUTH_TOKEN": "dummy",
        "ANTHROPIC_DEFAULT_OPUS_MODEL": "my-model",
        "ANTHROPIC_DEFAULT_SONNET_MODEL": "my-model",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": "my-model",
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
      }
    },
    "pi": {
      "enabled": true,
      "command": "pi"
    },
    "aider": {
      "enabled": false,
      "command": "aider",
      "args": ["--model", "openai/my-model", "--openai-api-base", "http://localhost:8000/v1", "--openai-api-key", "dummy"]
    }
  },
  "llm": {
    "provider": "vllm",
    "baseUrl": "http://localhost:8000/v1",
    "model": "default"
  },
  "autoPr": {
    "harness": "pi",
    "instructions": "/pr"
  },
  "server": {
    "port": 4000
  },
  "tokenUsage": {
    "file": "~/scripts/vllm-token-usage.json",
    "pricing": {
      "label": "Claude Sonnet",
      "inputPerM": 3,
      "outputPerM": 15
    }
  },
  "users": [
    "alice"
  ],
  "registration": "closed"
}
